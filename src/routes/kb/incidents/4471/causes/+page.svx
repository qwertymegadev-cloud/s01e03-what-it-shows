<script>
  import reports from '#lib/data/reports-4471.json';
  import notes from '#lib/data/desk-notes.json';
  import { groupByCause, readAs, uniqueById } from '#lib/kb/causes';
  import { tenantOf } from '#lib/kb/locales';
  import CauseTable from '#lib/kb/CauseTable.svelte';
  import Callout from '#lib/kb/Callout.svelte';
  import RenderStamp from '#lib/kb/RenderStamp.svelte';

  const repo = 'https://github.com/qwertymegadev-cloud/s01e03-what-it-shows/issues';

  // The desk's own view, as exported: every report counts under the cause it is filed under.
  // The one-day moves are the desk's footnote under that cause (readAs), so they count there too.
  const merged = uniqueById(reports).filter((r) => r.mergedInto === 4471);
  const groups = groupByCause(merged, tenantOf);
  const filed = (cause) => groups.find((g) => g.cause === cause);
  const count = (cause) => filed(cause)?.reports.length ?? 0;
  const oneDay = groups.reduce((n, g) => n + readAs(g, notes.oneDayMove), 0);

  const problems = [
    { key: 'parser', what: 'the shared parser reads day-first dates month first', reports: count('parser'), ticket: 1 },
    { key: 'hint', what: 'the booking-v3 form hints MM/DD/YYYY, then reads the date day first', reports: count('hint'), ticket: 2 },
    { key: 'one-day', what: 'the booking lands one day early, not flipped', reports: oneDay, ticket: 3 },
  ];
</script>

[#4471](/kb/incidents/4471) says one issue with one fix queued. Read report by report, it holds
three problems. Each needs its own fix, and each now has its own ticket.

<Callout kind="warn">
The parser fix queued for #4471 does not close #4471. The booking-v3 form and the one-day moves
stay broken after it ships.
</Callout>

## The problems in #4471

